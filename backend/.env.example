# Barbería Denver — Backend Environment Variables
# Copy this file to .env and fill in your values

# =====================
# DATABASE (Neon.tech)
# =====================
DATABASE_URL="postgresql://neondb_owner:npg_d8xgoZpELe1H@ep-shy-cherry-ayj76f4o-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# =====================
# SERVER
# =====================
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# =====================
# FIREBASE ADMIN SDK
# =====================
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=barberia-denver
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@barberia-denver.iam.gserviceaccount.com

# =====================
# JWT (optional extra layer)
# =====================
JWT_SECRET=change-this-to-a-random-secret-in-production
